<IfModule mod_rewrite.c>

RewriteEngine On


# =========================================
# PRODUZIONE: forza HTTPS + WWW
# In localhost non interviene
# =========================================

RewriteCond %{HTTP_HOST} ^sottoradice\.it$ [NC]
RewriteRule ^ https://www.sottoradice.it%{REQUEST_URI} [R=301,L]


# =========================================
# REDIRECT VECCHI URL .PHP
# Solo in produzione
# =========================================

# home.php -> /
RewriteCond %{HTTP_HOST} ^(www\.)?sottoradice\.it$ [NC]
RewriteCond %{THE_REQUEST} \s/+home\.php(?:[\s?]|$) [NC]
RewriteRule ^home\.php$ / [R=301,L]

# progetti.php -> /progetti/
RewriteCond %{HTTP_HOST} ^(www\.)?sottoradice\.it$ [NC]
RewriteCond %{THE_REQUEST} \s/+progetti\.php(?:[\s?]|$) [NC]
RewriteRule ^progetti\.php$ /progetti/ [R=301,L]

# chi-siamo.php -> /chi-siamo/
RewriteCond %{HTTP_HOST} ^(www\.)?sottoradice\.it$ [NC]
RewriteCond %{THE_REQUEST} \s/+chi-siamo\.php(?:[\s?]|$) [NC]
RewriteRule ^chi-siamo\.php$ /chi-siamo/ [R=301,L]

# vecchi URL dei singoli progetti
# /progetti/nome.php -> /progetti/nome/
# escluso il controller progetto.php
RewriteCond %{HTTP_HOST} ^(www\.)?sottoradice\.it$ [NC]
RewriteCond %{THE_REQUEST} \s/+progetti/([^?\s]+)\.php(?:[\s?]|$) [NC]
RewriteCond %1 !^progetto$ [NC]
RewriteRule ^progetti/([^/]+)\.php$ /progetti/$1/ [R=301,L]


# =========================================
# ROOT -> home.php
# =========================================

RewriteRule ^$ home.php [L]


# =========================================
# ELENCO PROGETTI
# /progetti/ -> progetti.php
# =========================================

RewriteRule ^progetti/?$ progetti.php [L]


# =========================================
# APP DEI PROGETTI
# /progetti/{slug}/gioca
# -> progetti/{slug}/gioca.php
#
# IMPORTANTE:
# questa regola deve stare PRIMA del controllo
# delle cartelle reali
# =========================================

RewriteRule ^progetti/([^/]+)/gioca/?$ progetti/$1/gioca.php [L]


# =========================================
# PROGETTI DINAMICI
# /progetti/{slug}/
# -> progetti/progetto.php?slug={slug}
#
# IMPORTANTE:
# anche questa regola deve stare PRIMA
# del controllo delle cartelle reali
# =========================================

RewriteRule ^progetti/([^/]+)/?$ progetti/progetto.php?slug=$1 [QSA,L]


# =========================================
# NON TOCCARE FILE O CARTELLE REALI
# =========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# =========================================
# PAGINE PRINCIPALI
# /chi-siamo/ -> chi-siamo.php
# =========================================

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)/?$ $1.php [L]


# =========================================
# 404
# Tutto ciò che non è stato intercettato sopra
# =========================================

RewriteRule ^ not_found.php [L]

</IfModule>